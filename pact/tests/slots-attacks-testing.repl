(begin-tx)
(snap14.keep "w1" (m14.world))
(snap14.keep "r1" (m14.round1))
(commit-tx)
;; A-16 again, on the OPEN round: an unknown machine cannot join it either
(env-sigs [{"key":"a11ce00000000000000000000000000000000000000000000000000000000001"
           ,"caps":[(coin.TRANSFER m14.ALICE (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account) 1000.0)]}])
(begin-tx)
(expect-failure "A-16i machine 6 cannot join the open round"
