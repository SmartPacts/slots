;; ============================================================================
;; CF-9n  THE NEXT-UNIT BRANCH, ON EVERY MACHINE
;;   max-board floors the quotient, then tries one unit more against `bet`'s own
;;   inequality, because `bet` floors the fee. For each machine a pot was found
;;   (Python search over 50,000 + k x 0.000001 at scale 1, same model) where that
;;   next unit fits: the published figure is the quotient's floor PLUS 1e-12, it
;;   is accepted, and one more unit is refused. The extra funding and the scale-1
;;   target are inside each probe's rolled-back transaction.
;; ============================================================================
(begin-tx)
(c9.scale1)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.fund-house "house-funder" 0.020437)
(expect "CF-9n.00 PRECONDITION the pot is 50000.020437 at scale 1" [50000.020437 1.0]
  [(at 'available (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status)) (at 'fee-scale-now (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status))])
;; the quotient alone floors to 24.975010818022; the next unit fits
(expect "CF-9n.01 machine 0 publishes the quotient's floor plus one unit" 24.975010818023 (c9.ms 0))
(expect "CF-9n.02 and it is accepted verbatim" "bet placed in round 1"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.ALICE (c9.wm 0 24.975010818023 1)))
(rollback-tx)
(begin-tx)
(c9.scale1)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.fund-house "house-funder" 0.020437)
(expect-failure "CF-9n.03 one unit more is refused by the table limit"
  "would exceed the table limit"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.ALICE (c9.wm 0 (+ 24.975010818023 0.000000000001) 1)))
(rollback-tx)
(begin-tx)
(c9.scale1)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.fund-house "house-funder" 0.000007)
(expect "CF-9n.10 PRECONDITION the pot is 50000.000007 at scale 1" [50000.000007 1.0]
  [(at 'available (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status)) (at 'fee-scale-now (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status))])
;; the quotient alone floors to 55.432252484347; the next unit fits
(expect "CF-9n.11 machine 1 publishes the quotient's floor plus one unit" 55.432252484348 (c9.ms 1))
(expect "CF-9n.12 and it is accepted verbatim" "bet placed in round 1"
