;; ============================================================================
;; CF-10  ONE MACHINE PER BOARD AGAINST THE TABLE LIMIT
;;   A board plays one machine, so the table limit binds what the round's BOARDS add up to.
;;   Same world as CF-9 (pot 50,000, target 100,000, scale 0.5, empty-table cap 0.02 x
;;   50,000 = 1,000).
;;   CF-10a  max-stakes is each machine's one-board maximum on the empty table
;;   CF-10b  a board of two machines is refused by its COUNT before the limit is looked at,
;;           whether or not its sum would fit
;;   CF-10e  two boards that each fit their own max-stakes do not fit together: the second
;;           is refused by the table limit
;;   CF-10h  with another board in the round, max-stakes is exactly the largest board `bet`
;;           accepts on every machine
;;   VALUES: eo.Table (not published), an exact Fraction
;;   model of `bet` and `pot-status`: fee floor(scale x edge x total, 12), multipliers 40 18
;;   250 40 100 563/5 and edges from the return fractions as literals; it reproduces CF-10a.
;; ============================================================================
(begin-tx)
(expect "CF-10a max-stakes on the empty table is the one-board maximum of each machine (model)"
  [24.987494052049 55.493835523641 3.999679713147 24.987532160924 9.998239746549 8.879398646195]
  (at 'max-stakes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status)))
(expect "CF-10a1 CONTROL each is the quotient room / (MAX-MULT + scale x edge) of ONE machine: machine 2 is 1000 / 250.02001953125, floored" true
  (= (at 2 (at 'max-stakes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status))) (floor (/ 1000.0 250.02001953125) 12)))
(rollback-tx)
(begin-tx)
(expect-failure "CF-10b a two-machine board whose sum would fit the limit is refused by its count"
  "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.ALICE { "entries": [{ "machine": 5, "stake": 0.100000000049, "spins": 10 } { "machine": 0, "stake": 1.0, "spins": 1 }] }))
(rollback-tx)
(begin-tx)
(expect-failure "CF-10b1 and a two-machine board far over the limit gets the COUNT message, not the limit's"
  "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.ALICE { "entries": [{ "machine": 0, "stake": 24.987494052049, "spins": 1 } { "machine": 2, "stake": 3.999679713147, "spins": 1 }] }))
(rollback-tx)
(begin-tx)
(expect "CF-10e0 PRECONDITION machine 0's published maximum 24.987494052049 is accepted ALONE" "bet placed in round 1"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.ALICE { "entries": [{ "machine": 0, "stake": 24.987494052049, "spins": 1 }] }))
(rollback-tx)
(begin-tx)
(expect "CF-10e1 PRECONDITION machine 2's published maximum 3.999679713147 is accepted ALONE" "bet placed in round 1"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.BOBBY { "entries": [{ "machine": 2, "stake": 3.999679713147, "spins": 1 }] }))
(rollback-tx)
(begin-tx)
(expect "CF-10f0 alice's classic at its own maximum opens the round" "bet placed in round 1"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.ALICE { "entries": [{ "machine": 0, "stake": 24.987494052049, "spins": 1 }] }))
(expect-failure "CF-10f bob's big at ITS own maximum beside it is refused by the table limit (charge 1999.99843858132 over 980.4997498810411, model)"
  "would exceed the table limit"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.BOBBY { "entries": [{ "machine": 2, "stake": 3.999679713147, "spins": 1 }] }))
(rollback-tx)
;; bob's one-machine board (free-spins 0.05 x 20) opens the round; the headroom left is
;; shared, and max-stakes publishes each machine's one-board maximum of it
(begin-tx)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet c9.BOBBY { "entries": [{ "machine": 4, "stake": 0.05, "spins": 20 }] })
(expect "CF-10h PRECONDITION bob's board holds one machine" [4]
  (map (lambda (e:object) (at 'machine e)) (at 'entries (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-board 1 c9.BOBBY))))
(expect "CF-10h1 max-stakes beside it, every machine (model)"
  [22.438842918521 49.833687271478 3.591721120307 22.438877072665 8.978442841158 7.973720956067]
  (at 'max-stakes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status)))
(rollback-tx)
