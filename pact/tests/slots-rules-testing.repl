;; tumble-units: three hand-picked stop triples, cascades traced by rules_oracle.py (f_cascade.simulate);
;; columns read bottom..top, codes 0 blank 1 cherry 2 bell 3 bar 4 seven; lines = rows 0,1,2 and diagonals;
;; line pays cherry 7, bell 18, bar 35, seven 80; cascade k pays x k.
;;   [0 0 3]: cols [4 3 2] [4 3 2] [1 1 2] -> c1 top row bells 18 x1; refill [4 3 1] [4 3 1] [1 1 0]: no line. = 18
;;   [0 0 8]: cols [4 3 2] [4 3 2] [3 0 2] -> c1 top bells 18; then [4 3 1] [4 3 1] [3 0 1] top cherries 7 x2;
;;            then [4 3 1] [4 3 1] [3 0 1] top cherries 7 x3; then [4 3 2] [4 3 2] [3 0 0]: stop. = 18+14+21 = 53
;;   [8 8 8]: cols [3 0 2] x3 -> c1 bottom bars 35 + top bells 18 = 53; [0 1 1] x3 -> c2 middle and top
;;            cherries 14 x2 = 28; [0 0 2] x3 -> c3 bells 18 x3 = 54; [0 0 1] x3 -> c4 cherries 7 x4 = 28;
;;            [0 0 4] x3 -> c5 sevens 80 x5 = 400; five cascades is TUMBLE-MAX. = 563, the machine's maximum
(expect "M3h tumble-units [0 0 3] is 18"
  18
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.tumble-units smartpacts.srules.REEL-5 smartpacts.srules.PAYS-5 [0 0 3]))
(expect "M3h tumble-units [0 0 8] is 53"
  53
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.tumble-units smartpacts.srules.REEL-5 smartpacts.srules.PAYS-5 [0 0 8]))
(expect "M3h tumble-units [8 8 8] is 563"
  563
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.tumble-units smartpacts.srules.REEL-5 smartpacts.srules.PAYS-5 [8 8 8]))
;; the beacon-to-reels recipe, per machine: board-seed = hash("{seed}|{account}"), spin i's key =
;; "{bseed}|{i}", stops = three low 6-bit slices of str-to-int 64 (hash key). Seed = round 1 of the
;; fixture (beacon 20801767). Values: boards.py (reproduce.pact_hash / str_to_int64 + rules_oracle
;; evaluators); payout = floor(stake x units / div, 12).
;; machine 0 (classic): k:a11ce00000000000000000000000000000000000000000000000000000000001, 20 spins at 0.1; per-spin units [0 0 0 2 0 0 0 0 5 0 0 0 0 0 0 0 0 0 2 0]
(expect "M3i.0 board-seed of the round-1 seed and k:a11ce00000.. is the Python digest"
  "ay_qyiNUEecoi5yhL3C-Lj8P0Kku4STxLY1U3T9FaLA"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.board-seed 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001"))
(expect "M3j.0 spin-key of it for spin 1"
  "ay_qyiNUEecoi5yhL3C-Lj8P0Kku4STxLY1U3T9FaLA|1"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-key "ay_qyiNUEecoi5yhL3C-Lj8P0Kku4STxLY1U3T9FaLA" 1))
(expect "M3k.0 key-stops of spin 1 is [47 20 0]"
  [47 20 0]
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.key-stops "ay_qyiNUEecoi5yhL3C-Lj8P0Kku4STxLY1U3T9FaLA|1"))
(expect "M3l.0 play-board on machine 0: 9 units, payout 0.9"
  { "stops": [ 47 20 0 25 12 60 4 33 52 1 7 13 6 6 46 14 54 3 26 51 39 40 27 52 1 33 51 7 18 48
              18 58 6 47 30 41 7 55 59 8 55 1 38 15 52 62 43 16 32 31 51 16 40 43 23 5 10 28 57 23 ]
  , "units": 9, "payout": 0.9 }
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887
    "k:a11ce00000000000000000000000000000000000000000000000000000000001" 0 20 0.1))
