    { "units": (at 'units p), "payout": (at 'payout p) }))
;; a one-entry board plays EXACTLY as play-board: the six M3l boards again, through play-entries
(expect "M5g.0 a one-entry play-entries on machine 0 equals play-board: same stops, units [9], payout 0.9" true
  (let ((pe (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-entries 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" [{ "machine": 0, "stake": 0.1, "spins": 20 }]))
