  (let ((es [{ "machine": 4, "stake": 0.1, "spins": 20 }]))
    (enforce (= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-reserve es) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.board-reserve 4 (* 0.1 20.0))) "reserve differs from board-reserve")
    (enforce (= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-fee es 0.5) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.fee-for 4 (* 0.1 20.0) 0.5)) "fee differs from fee-for")
    [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-reserve es) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-fee es 0.5)]))
