;; CONTROL: the tally is not blind -- classic's stop 0 (a seven) turned into a code 5 moves two counts
(expect "M1n CONTROL the tally sees a single changed stop on the classic strip"
  [38 8 8 8 1 1]
  (smartpacts.srules.tally (smartpacts.srules.put smartpacts.srules.REEL-0 0 5)))
;; On one uniform strip the neighbour property holds by construction (the shifted strip is a rotation);
;; what M1k pins is that a stop IS a strip position. CONTROL: the shift really moved each strip.
(expect "M1o CONTROL for every machine the strip one stop above and one stop below differ from the line itself"
  [false false false false false false]
  (map (lambda (r:[integer]) (or (= r (smartpacts.srules.shifted r 63)) (= r (smartpacts.srules.shifted r 1)))) [smartpacts.srules.REEL-0 smartpacts.srules.REEL-1 smartpacts.srules.REEL-2 smartpacts.srules.REEL-3 smartpacts.srules.REEL-4 smartpacts.srules.REEL-5]))
(expect "M1p wrap: above classic's stop 0 is stop 63 (blank), below stop 63 is stop 0 (seven)"
  [0 4]
  [(at 0 (smartpacts.srules.shifted smartpacts.srules.REEL-0 63)) (at 63 (smartpacts.srules.shifted smartpacts.srules.REEL-0 1))])
(commit-tx)

;; ============================================================================
;; M2 — THE EXACT RETURN OF EVERY MACHINE
;; ============================================================================
;; WHY: the module computes the line and wild returns at load and pins the other two. Each is
;; pinned as a literal, the line/wild ones are recomputed here from the literal counts and pay
;; lists, and each is stated as the reduced fraction players are told.
(begin-tx "M2: the returns")
(expect "M2a RETURNS is the literal [num den] of all six machines (the free-spins pair is d_free.py's printed fraction)"
  [[251648 262144] [251648 262144] [251648 262144] [251680 262144] [9063389690458042355601938653540158107548580822591401155618918013981973816811062613547804594484841949198261321 9394170331095332911557922387157348109502730195633279482829163886128836100458433773854795993539074812127739904] [19651 20480]]
  n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.RETURNS)
(expect "M2b TRIPLES is the 216 ordered triples [0 0 0] .. [5 5 5], a outermost"
  smartpacts.srules.TRIPLES-LIT
  n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.TRIPLES)
(expect "M2c.0 machine 0: the weighted sum over the LITERAL counts and the LITERAL 216-entry pay list is 251648"
  251648
  (smartpacts.srules.return-units (smartpacts.srules.tally smartpacts.srules.REEL-0) smartpacts.srules.LIST-0))
(expect "M2d.0 machine 0: triple-units over all 216 triples equals the oracle's pay list"
  smartpacts.srules.LIST-0
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.triple-units (at 0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.MACHINES)) smartpacts.srules.TRIPLES-LIT))
(expect "M2e.0 machine 0: 251648/262144 is exactly 983/1024 (cross-multiplication)"
  true
  (= (* 1024 251648) (* 983 262144)))
(expect "M2c.1 machine 1: the weighted sum over the LITERAL counts and the LITERAL 216-entry pay list is 251648"
  251648
  (smartpacts.srules.return-units (smartpacts.srules.tally smartpacts.srules.REEL-1) smartpacts.srules.LIST-1))
(expect "M2d.1 machine 1: triple-units over all 216 triples equals the oracle's pay list"
  smartpacts.srules.LIST-1
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.triple-units (at 1 n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.MACHINES)) smartpacts.srules.TRIPLES-LIT))
(expect "M2e.1 machine 1: 251648/262144 is exactly 983/1024 (cross-multiplication)"
  true
  (= (* 1024 251648) (* 983 262144)))
(expect "M2c.2 machine 2: the weighted sum over the LITERAL counts and the LITERAL 216-entry pay list is 251648"
  251648
  (smartpacts.srules.return-units (smartpacts.srules.tally smartpacts.srules.REEL-2) smartpacts.srules.LIST-2))
(expect "M2d.2 machine 2: triple-units over all 216 triples equals the oracle's pay list"
  smartpacts.srules.LIST-2
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.triple-units (at 2 n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.MACHINES)) smartpacts.srules.TRIPLES-LIT))
(expect "M2e.2 machine 2: 251648/262144 is exactly 983/1024 (cross-multiplication)"
  true
  (= (* 1024 251648) (* 983 262144)))
(expect "M2c.3 machine 3: the weighted sum over the LITERAL counts and the LITERAL 216-entry pay list is 251680"
  251680
  (smartpacts.srules.return-units (smartpacts.srules.tally smartpacts.srules.REEL-3) smartpacts.srules.LIST-3))
(expect "M2d.3 machine 3: triple-units over all 216 triples equals the oracle's pay list"
  smartpacts.srules.LIST-3
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.triple-units (at 3 n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.MACHINES)) smartpacts.srules.TRIPLES-LIT))
(expect "M2e.3 machine 3: 251680/262144 is exactly 7865/8192 (cross-multiplication)"
  true
  (= (* 8192 251680) (* 7865 262144)))
(expect "M2f free-spins: the pinned fraction is 109 digits over 109 digits, already in lowest terms (Python Fraction leaves it unchanged)"
  [109 109]
  [(length (int-to-str 10 (at 0 (at 4 n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.RETURNS)))) (length (int-to-str 10 (at 1 (at 4 n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.RETURNS))))])
(expect "M2g tumble: the line units over all 262,144 stop triples total 1257664 (rules_oracle.py enumeration), at a line bet of 1/5: 1257664/1310720 is exactly 19651/20480 (f_cascade.py printed RTP=19651/20480)"
  true
  (= (* 20480 1257664) (* 19651 1310720)))
;; CONTROL: the return recomputation is not blind -- three sevens paying one more on classic moves it by 2x2x2 = 8
(expect "M2h CONTROL classic with three sevens at 41 returns 251656, not 251648"
  251656
  (smartpacts.srules.return-units (smartpacts.srules.tally smartpacts.srules.REEL-0) (smartpacts.srules.put smartpacts.srules.LIST-0 172 41)))
(expect "M2i EDGES, floored at 30 places (rules_oracle.py dec30: floor((den-num)*10^30/den))"
  [0.0400390625 0.0400390625 0.0400390625 0.0399169921875 0.035211267092143782350633855823 0.040478515625]
  n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.EDGES)
(expect "M2j the classic edge 0.0400390625 is 41/1024 and 983 + 41 = 1024"
  [0.0400390625 1024]
  [(/ 41.0 1024.0) (+ 983 41)])
(expect "M2k MAX-MULTS = max-units / div"
  [40.0 18.0 250.0 40.0 100.0 112.6]
  n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.MAX-MULTS)
(expect "M2l.0 machine 0: the smallest win that can show is 2x the stake (>= 2)"
  2
  (smartpacts.srules.imin-pos (smartpacts.srules.live-pays (smartpacts.srules.tally smartpacts.srules.REEL-0) smartpacts.srules.LIST-0)))
(expect "M2l.1 machine 1: the smallest win that can show is 2x the stake (>= 2)"
  2
  (smartpacts.srules.imin-pos (smartpacts.srules.live-pays (smartpacts.srules.tally smartpacts.srules.REEL-1) smartpacts.srules.LIST-1)))
(expect "M2l.2 machine 2: the smallest win that can show is 4x the stake (>= 2)"
  4
  (smartpacts.srules.imin-pos (smartpacts.srules.live-pays (smartpacts.srules.tally smartpacts.srules.REEL-2) smartpacts.srules.LIST-2)))
(expect "M2l.3 machine 3: the smallest win that can show is 2x the stake (>= 2)"
  2
  (smartpacts.srules.imin-pos (smartpacts.srules.live-pays (smartpacts.srules.tally smartpacts.srules.REEL-3) smartpacts.srules.LIST-3)))
(expect "M2m no line or wild machine has a showing win below 2x the stake"
  []
  (filter (lambda (x:integer) (< x 2)) (map (lambda (i:integer) (smartpacts.srules.imin-pos (smartpacts.srules.live-pays (smartpacts.srules.tally (at i [smartpacts.srules.REEL-0 smartpacts.srules.REEL-1 smartpacts.srules.REEL-2 smartpacts.srules.REEL-3])) (at i [smartpacts.srules.LIST-0 smartpacts.srules.LIST-1 smartpacts.srules.LIST-2 smartpacts.srules.LIST-3])))) [0 1 2 3])))
(expect "M2n free-spins: its smallest line pay is 2 (d_free.py printed 'min nonzero spin return: 2'); a bonus is FREE-MULT 2 x a line, so at least 4"
  [2 4]
  (let ((m (smartpacts.srules.imin-pos (take 7 smartpacts.srules.PAYS-4)))) [m (* 2 m)]))
(expect "M2o tumble: its smallest win is 7 line units = 1.4x the spin's stake (7/5; rules_oracle.py enumeration 'min win 7'): no win returns less than the stake"
  [7 1.4 true]
  (let ((m (smartpacts.srules.imin-pos smartpacts.srules.PAYS-5))) [m (/ (dec m) 5.0) (>= (dec m) 5.0)]))
(commit-tx)

;; ============================================================================
;; M3 — THE EVALUATORS AGAINST THE ORACLE
;; ============================================================================
;; WHY: a player checks a result by recomputing it. spin-units is compared on 56 keys per
;; machine, including every rare path the parity harness hunted: two and three wilds
;; (hunt|102..5833, hunt|2587 = three wilds and a five-cascade tumble), free-spins triggers
;; (hunt|96, 374, 509 and the six of the "retrig" group), a trigger with one retrigger
;; (hunt|15931: 16 free spins), two retriggers to FREE-MAX (hunt|122090: 24 free spins), the
;; bonus reaching FREE-CAP 100 (hunt|440466: stops after 12 free spins), and tumbles of 3 or
;; more cascades (hunt|147..577).
(begin-tx "M3: evaluator parity")
(expect "M3a.0 machine 0 (classic): spin-units on all 56 keys equals the oracle's list"
  smartpacts.srules.UNITS-0
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 0) smartpacts.srules.KEYS))
(expect "M3a.1 machine 1 (easy): spin-units on all 56 keys equals the oracle's list"
  smartpacts.srules.UNITS-1
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 1) smartpacts.srules.KEYS))
(expect "M3a.2 machine 2 (big): spin-units on all 56 keys equals the oracle's list"
  smartpacts.srules.UNITS-2
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 2) smartpacts.srules.KEYS))
(expect "M3a.3 machine 3 (wild): spin-units on all 56 keys equals the oracle's list"
  smartpacts.srules.UNITS-3
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 3) smartpacts.srules.KEYS))
(expect "M3a.4 machine 4 (free-spins): spin-units on all 56 keys equals the oracle's list"
  smartpacts.srules.UNITS-4
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 4) smartpacts.srules.KEYS))
(expect "M3a.5 machine 5 (tumble): spin-units on all 56 keys equals the oracle's list"
  smartpacts.srules.UNITS-5
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 5) smartpacts.srules.KEYS))
(expect "M3b the keys are 56 and every hunted key of diff/py.json is among them"
  [56 24]
  [(length smartpacts.srules.KEYS) (length (filter (lambda (k:string) (= "hunt" (take 4 k))) (take 54 smartpacts.srules.KEYS)))])
;; CONTROL: the comparison is not blind -- the classic list with one entry changed does not match
(expect "M3c CONTROL a UNITS list with one entry changed does not match"
  false
  (= (smartpacts.srules.put smartpacts.srules.UNITS-0 0 1) (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.spin-units 0) smartpacts.srules.KEYS)))
(expect "M3d free-bonus on one retrigger, two retriggers (FREE-MAX) and the FREE-CAP stop: the oracle's bonus (the trigger line pays 0, so bonus = units)"
  [38 84 100]
  (map (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.free-bonus smartpacts.srules.REEL-4 smartpacts.srules.PAYS-4) ["hunt|15931" "hunt|122090" "hunt|440466"]))
;; machine 0 (classic): one line per paytable category, values = common.pay3(40, 20, 10, 15, 5, 5, 2)
(expect "M3e.0 classic: three sevens [4 4 4] pays 40"
  40
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.line-pay smartpacts.srules.PAYS-0 4 4 4))
(expect "M3e.0 classic: three bars [3 3 3] pays 20"
  20
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.line-pay smartpacts.srules.PAYS-0 3 3 3))
(expect "M3e.0 classic: three bells [2 2 2] pays 10"
  10
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.line-pay smartpacts.srules.PAYS-0 2 2 2))
(expect "M3e.0 classic: three cherries [1 1 1] pays 15"
  15
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.line-pay smartpacts.srules.PAYS-0 1 1 1))
(expect "M3e.0 classic: any three high: bell bar seven [2 3 4] pays 5"
  5
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.line-pay smartpacts.srules.PAYS-0 2 3 4))
(expect "M3e.0 classic: any three high: seven seven bar (two sevens are not three) [4 4 3] pays 5"
