  (let ((pe (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-entries 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:ca40100000000000000000000000000000000000000000000000000000000003" [{ "machine": 5, "stake": 0.3, "spins": 10 }]))
        (pb (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:ca40100000000000000000000000000000000000000000000000000000000003" 5 10 0.3)))
    (and (= (at 'stops pe) (at 'stops pb))
         (and (= (at 'units pe) [(at 'units pb)]) (and (= (at 'units pe) [14]) (= (at 'payout pe) (at 'payout pb)))))))
