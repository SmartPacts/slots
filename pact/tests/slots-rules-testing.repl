;; the stops depend on the spin index alone, never the machine: the six-entry board's 41 spins stop
;; exactly where a 41-spin one-machine board of the same account stops, so the numbering runs on
;; across entries and never restarts
(expect "M5e the six-entry board's stops are the first 41 spins of alice's key stream, numbered across entries" true
  (= (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-entries 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" [{ "machine": 3, "stake": 1.0, "spins": 3 } { "machine": 0, "stake": 0.1, "spins": 20 } { "machine": 5, "stake": 0.3, "spins": 5 } { "machine": 1, "stake": 0.2, "spins": 4 } { "machine": 4, "stake": 0.1, "spins": 7 } { "machine": 2, "stake": 0.5, "spins": 2 }]))
     (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 0 41 1.0))))
(expect "M5e1 CONTROL a numbering that restarted at 1 for every entry would give other stops" false
  (= (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-entries 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" [{ "machine": 3, "stake": 1.0, "spins": 3 } { "machine": 0, "stake": 0.1, "spins": 20 } { "machine": 5, "stake": 0.3, "spins": 5 } { "machine": 1, "stake": 0.2, "spins": 4 } { "machine": 4, "stake": 0.1, "spins": 7 } { "machine": 2, "stake": 0.5, "spins": 2 }]))
     (+ (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 3 3 1.0)) (+ (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 0 20 1.0)) (+ (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 5 5 1.0)) (+ (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 4 1.0)) (+ (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 4 7 1.0)) (at 'stops (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board 41473200179623307258957694415769443739304335489542769187234381733079227613887 "k:a11ce00000000000000000000000000000000000000000000000000000000001" 2 2 1.0)))))))))
