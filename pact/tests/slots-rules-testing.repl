  (let ((es [{ "machine": 5, "stake": 0.3, "spins": 10 }]))
    (enforce (= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-reserve es) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.board-reserve 5 (* 0.3 10.0))) "reserve differs from board-reserve")
    (enforce (= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-fee es 0.5) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.fee-for 5 (* 0.3 10.0) 0.5)) "fee differs from fee-for")
    [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-reserve es) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-fee es 0.5)]))
;; the fee is floored PER ENTRY: on the six-entry board at scale 1 the per-entry floors sum to
;; 0.357265074463, one unit below 0.357265074464, the floor of the unfloored sum -- so a fee floored per board
;; instead of per entry would be caught by M5bf above
(expect "M5i CONTROL the per-entry floors (0.357265074463) sit one unit under the board-level floor (0.357265074464)" true
  (< (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.entries-fee [{ "machine": 3, "stake": 1.0, "spins": 3 } { "machine": 0, "stake": 0.1, "spins": 20 } { "machine": 5, "stake": 0.3, "spins": 5 } { "machine": 1, "stake": 0.2, "spins": 4 } { "machine": 4, "stake": 0.1, "spins": 7 } { "machine": 2, "stake": 0.5, "spins": 2 }] 1.0) 0.357265074464))
