;; ---------------------------------------------------------------- M-5 machine 2, big
;; stest.CAROL places 0.1 x 20 on machine 2: total 2.0, exposure 250 x total = 500.0,
;; fee floor(0.5 x 0.0400390625 x 2.0, 12) = 0.040039062500. Under the round-4 seed of beacon
;; 20801767 the oracle gives units per spin 0 0 0 0 0 4 0 0 0 0 4 0 0 0 0 4 0 0 0 0 = 12, payout
;; floor(0.1 x 12 / 1, 12) = 1.200000000000.
(env-chain-data { "block-time": (time "2026-09-20T17:43:43Z") })
(env-sigs [{"key":"ca40100000000000000000000000000000000000000000000000000000000003"
           ,"caps":[(coin.TRANSFER stest.CAROL (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account) 2.0)]}])
(begin-tx)
(env-events true)
(expect "M-5 PRECONDITION the fee runs at exactly half the edge" 0.5 (at 'fee-scale-now (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status)))
(expect "M-5a a board on machine 2 opens round 4" "bet placed in round 4" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.CAROL (stest.wm 2 0.1 20)))
(expect "M-5b the round's exposure is exactly 250 x 2.0" 500.0 (at 'exposure (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-round 4)))
(expect "M-5c its fee is floor(0.5 x edge x total, 12)" 0.040039062500 (at 'fee-owed (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-round 4)))
