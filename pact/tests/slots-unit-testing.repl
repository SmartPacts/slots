  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.BET-PLACED", "params": [stest.ERIN 4 [5] 1.5 168.928424504368] } (stest.evs)))
(commit-tx)
(env-sigs [])
(begin-tx)
(expect "M-9g the round holds six boards on six machines" [0 1 2 3 4 5]
