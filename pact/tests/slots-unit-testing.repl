  (let ((b (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-board 4 stest.BOB))) [(stest.bm b) (at 'stops b) (at 'payout b)]))
(expect "M-4j SPINS-SETTLED carries machines [1]" true
  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.SPINS-SETTLED", "params": [stest.BOB 4 [1] [23 42 14 16 23 15 46 4 50 32 52 17 2 55 8 28 40 29 6 3 13 11 15 47 60 56 18 22 58 25 18 10 7 2 14 19 0 26 44 54 23 33 2 61 38 50 7 51 63 8 0 4 25 15 59 2 24 0 40 19] 2.600000000000] } (stest.evs)))
(expect "M-4k reserved returns to EXACTLY 0.0" 0.0 (at 'reserved (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params)))
(expect "M-4l and the round owes nothing" 0.0 (at 'liability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-round 4)))
