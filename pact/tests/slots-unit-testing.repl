  (test-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.GOVERNANCE)))
(rollback-tx)
(env-sigs [{"key":"476f5e8a97ad059ab4a585666252db4cc65404f0dbec9db72257d99fe276ebef","caps":[]}])
(begin-tx)
(expect "W-2f CONTROL with the key, GOVERNANCE is granted" true
