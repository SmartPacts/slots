(expect "M-4d reserved is exposure + fee" 36.040039062500 (at 'reserved (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params)))
(expect "M-4e BET-PLACED carries machines [1]" true
  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.BET-PLACED", "params": [stest.BOB 4 [1] 2.0 36.040039062500] } (stest.evs)))
(env-chain-data { "block-time": (time "2026-09-20T17:47:00Z") })
(expect "M-4f the round resolves to the seed the oracle used"
