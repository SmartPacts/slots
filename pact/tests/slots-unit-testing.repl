(print "slots unit tests complete")

;; ============================================================================
;; GAP-VE16 (mutation sweep of 8c69704): within the entry the table minimum is checked
;; BEFORE coin precision.
;; ============================================================================
(begin-tx)
(expect-failure "GAP-VE16a a sub-minimum 13-decimal stake gets the MINIMUM message, not the precision one"
  "stake per spin below the table minimum"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.validate-wager
    { "entries": [{ "machine": 5, "stake": 0.0099999999995, "spins": 20 }] } 0.01))
(expect-failure "GAP-VE16b CONTROL at the minimum the same 13th decimal gets the precision message"
  "Amount violates minimum precision"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.validate-wager
    { "entries": [{ "machine": 5, "stake": 0.0100000000005, "spins": 20 }] } 0.01))
(rollback-tx)
