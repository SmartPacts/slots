(expect "M-9c1 BET-PLACED is (account, seq, machines [2], total, reserve added)" true
  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.BET-PLACED", "params": [stest.CAROL 4 [2] 1.00 250.019795152812] } (stest.evs)))
(commit-tx)
;; board 4: machine 3, 0.1 x 20 = 2.0; scale 0.481945021959, fee 0.038475591352, reserve added 80.038475591352
(env-sigs [{"key":"d500000000000000000000000000000000000000000000000000000000000001"
           ,"caps":[(coin.TRANSFER stest.DAVE (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account) 2.0)]}])
