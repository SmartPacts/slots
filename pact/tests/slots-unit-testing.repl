;; ============================================================================
;; MB-  A BOARD PLAYS ONE MACHINE
;;   A wager keeps its list shape, { "entries": [ {machine, stake, spins} ] }, so every
;;   tool, the page and the crank stay compatible, but it holds EXACTLY ONE entry. Any
;;   other count -- none, two to six machines, seven, or one machine named twice -- is
;;   refused with the same message before any entry is read, and nothing moves.
;;   MB-2 is the named test that goes RED if a two-machine board is accepted again.
;;   Round 5 opens at 17:43:43 and pins beacon 20801767. The pot enters it at
;;   10000.859874085046 with nothing reserved (M-9 left it there), share 0.5, target 20,000.
;; ============================================================================
(begin-tx)
(module mbt MBG (defcap MBG () (enforce true "ok"))
  ;; the round-5 seed (drand verified-seed recomputed off chain), used by MB-8
  (defconst SEED5 37668096285646320199641060908126814027211093282206467583149606883500438862613)
  ;; round-seq, current, reserved, the pot, alice: what a refused board must leave as it was
  (defun state:list ()
    (let ((g (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params)))
      [(at 'round-seq g) (at 'current g) (at 'reserved g)
       (coin.get-balance (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account)) (coin.get-balance stest.ALICE)])))
(commit-tx)
(env-chain-data { "block-time": (time "2026-09-20T17:43:43Z") })
(begin-tx)
(expect "MB-0 PRECONDITION round 4 is the last, nothing is reserved and the pot is where M-9 left it"
  [4 4 0.0 10000.859874085046]
  (let ((g (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params))) [(at 'round-seq g) (at 'current g) (at 'reserved g) (coin.get-balance (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account))]))
(expect "MB-0a PRECONDITION alice's balance, before any refused board below" 99998.6 (coin.get-balance stest.ALICE))
(expect "MB-0b CONTROL the state helper reads exactly those five figures" [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(commit-tx)
;; ---------------------------------------------------------------- MB-1 / MB-2 how many machines
(env-sigs [{"key":"a11ce00000000000000000000000000000000000000000000000000000000001"
           ,"caps":[(coin.TRANSFER stest.ALICE (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account) 100.0)]}])
(begin-tx)
(expect-failure "MB-1 a board with no machine is refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [])))
(expect "MB-1u ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2 ONE MACHINE: a board of two machines is refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 3 0.01 1)])))
(expect "MB-2u ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2a three machines are refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 3 0.01 1) (stest.e 5 0.01 1)])))
(expect "MB-2au ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2b four machines are refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 4 0.01 1) (stest.e 5 0.01 1) (stest.e 2 0.01 1) (stest.e 0 0.01 1)])))
(expect "MB-2bu ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2c five machines are refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 1 0.01 1) (stest.e 2 0.01 1) (stest.e 3 0.01 1) (stest.e 4 0.01 1)])))
(expect "MB-2cu ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2d all six machines are refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 1 0.01 1) (stest.e 2 0.01 1) (stest.e 3 0.01 1) (stest.e 4 0.01 1) (stest.e 5 0.01 1)])))
(expect "MB-2du ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2e seven entries are refused" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 1 0.01 1) (stest.e 2 0.01 1) (stest.e 3 0.01 1) (stest.e 4 0.01 1) (stest.e 5 0.01 1) (stest.e 0 0.01 1)])))
(expect "MB-2eu ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2f one machine named twice is refused: a board is one entry, not one machine id" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 2 0.01 1) (stest.e 2 0.01 1)])))
(expect "MB-2fu ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2g the count is checked BEFORE any entry: an unknown id in the 2nd entry gets the count message" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 9 0.01 1)])))
(expect "MB-2gu ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
(begin-tx)
(expect-failure "MB-2h and so does a sub-minimum stake in the 2nd entry" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 0 0.01 1) (stest.e 1 0.001 1)])))
(expect "MB-2hu ... and nothing moved: no round, nothing reserved, the pot and alice untouched"
  [4 4 0.0 10000.859874085046 99998.6] (mbt.state))
(rollback-tx)
;; ---------------------------------------------------------------- MB-3 validate-wager directly
(begin-tx)
(expect-failure "MB-3 validate-wager refuses 0 entries" "a board plays one machine"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.validate-wager (stest.ws []) 0.01))
(expect-failure "MB-3a and 2" "a board plays one machine"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.validate-wager (stest.ws [(stest.e 0 0.01 1) (stest.e 1 0.01 1)]) 0.01))
(expect-failure "MB-3b and 7" "a board plays one machine"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.validate-wager (stest.ws [(stest.e 0 0.01 1) (stest.e 1 0.01 1) (stest.e 2 0.01 1) (stest.e 3 0.01 1) (stest.e 4 0.01 1) (stest.e 5 0.01 1) (stest.e 0 0.01 1)]) 0.01))
(expect "MB-3c CONTROL one entry returns its total: 0.01 x 77" 0.77
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.validate-wager (stest.wm 4 0.01 77) 0.01))
(rollback-tx)
(begin-tx)
(env-events true)
(expect "MB-3d CONTROL a one-entry board is accepted" "bet placed in round 5"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 3 0.01 1)])))
(expect "MB-3e and its row holds exactly that one entry" [{ "machine": 3, "stake": 0.01, "spins": 1 }]
  (at 'entries (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-board 5 stest.ALICE)))
(expect "MB-3f and BET-PLACED carries a one-machine list" [[3]]
  (map (lambda (x:object) (at 2 (at 'params x)))
       (filter (lambda (x:object) (= (at 'name x) "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.BET-PLACED")) (stest.evs))))
(rollback-tx)
(begin-tx)
(expect-failure "MB-4 VALUE the whole message, as the terms and the page quote it" "a board plays one machine: it holds exactly one entry"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.ALICE (stest.ws [(stest.e 1 0.01 1) (stest.e 4 0.01 1)])))
(rollback-tx)
(env-sigs [])

;; ---------------------------------------------------------------- MB-8 one entry = play-board, every machine
;; play-entries with one entry and play-board agree on stops, payout and units, on
;; each of the six machines (20 spins of 0.010000000001 so the tumble payout floors).
(begin-tx)
(expect "MB-8a machine 0: a one-entry board plays exactly as play-board"
  (let ((p (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board mbt.SEED5 stest.ALICE 0 20 0.010000000001))) [(at 'stops p) (at 'payout p) [(at 'units p)]])
  (let ((q (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-entries mbt.SEED5 stest.ALICE [(stest.e 0 0.010000000001 20)]))) [(at 'stops q) (at 'payout q) (at 'units q)]))
(expect "MB-8b machine 1: a one-entry board plays exactly as play-board"
  (let ((p (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-board mbt.SEED5 stest.ALICE 1 20 0.010000000001))) [(at 'stops p) (at 'payout p) [(at 'units p)]])
  (let ((q (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.play-entries mbt.SEED5 stest.ALICE [(stest.e 1 0.010000000001 20)]))) [(at 'stops q) (at 'payout q) (at 'units q)]))
(expect "MB-8c machine 2: a one-entry board plays exactly as play-board"
