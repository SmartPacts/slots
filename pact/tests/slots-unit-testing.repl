(expect "M-9e1 BET-PLACED is (account, seq, machines [4], total, reserve added)" true
  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.BET-PLACED", "params": [stest.FRANK 4 [4] 2.0 200.033665006423] } (stest.evs)))
(commit-tx)
;; board 6: machine 5, 0.1 x 15 = 1.5; scale 0.468141414929, fee 0.028424504368, reserve added 168.928424504368
(env-sigs [{"key":"e50000000000000000000000000000000000000000000000000000000000009d"
           ,"caps":[(coin.TRANSFER stest.ERIN (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account) 1.5)]}])
(begin-tx)
(env-events true)
(expect "M-9f stest.ERIN places a board on machine 5 in round 4" "bet placed in round 4"
