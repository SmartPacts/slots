;; ---------------------------------------------------------------- M-7 machine 4, free-spins
;; stest.FRANK places 0.1 x 20 on machine 4: total 2.0, exposure 100 x total = 200.0,
;; fee floor(0.5 x 0.035211267092143782350633855823 x 2.0, 12) = 0.035211267092. Under the round-4 seed of beacon
;; 20801767 the oracle gives units per spin 2 0 0 3 2 0 0 0 0 3 46 2 2 2 0 0 90 0 3 0 = 155, payout
;; floor(0.1 x 155 / 1, 12) = 15.500000000000.
;; THIS BOARD RETRIGGERS: the account is the one of 200,000 k: keys searched
;; with the oracle (search.py) whose 20-spin board plays the most free spins under
;; this seed: spin 11 triggers and retriggers twice (24 free spins, the per-trigger
;; cap), spin 17 triggers and retriggers once (16), 40 free spins in all. Its
;; claim is the worst-case settlement gas pinned below.
(env-chain-data { "block-time": (time "2026-09-20T17:43:43Z") })
(env-sigs [{"key":"f50000000000000000000000000000000000000000000000000000000001c207"
           ,"caps":[(coin.TRANSFER stest.FRANK (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.house-account) 2.0)]}])
(begin-tx)
(env-events true)
(expect "M-7 PRECONDITION the fee runs at exactly half the edge" 0.5 (at 'fee-scale-now (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.pot-status)))
(expect "M-7a a board on machine 4 opens round 4" "bet placed in round 4" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.bet stest.FRANK (stest.wm 4 0.1 20)))
(expect "M-7b the round's exposure is exactly 100 x 2.0" 200.0 (at 'exposure (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-round 4)))
(expect "M-7c its fee is floor(0.5 x edge x total, 12)" 0.035211267092 (at 'fee-owed (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-round 4)))
(expect "M-7d reserved is exposure + fee" 200.035211267092 (at 'reserved (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params)))
(expect "M-7e BET-PLACED carries machines [4]" true
  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.BET-PLACED", "params": [stest.FRANK 4 [4] 2.0 200.035211267092] } (stest.evs)))
(env-chain-data { "block-time": (time "2026-09-20T17:47:00Z") })
(expect "M-7f the round resolves to the seed the oracle used"
  97923879012962035336606026723769801759014508549631002220168143137371049013191
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.resolve 4 stest.SIG))
(expect "M-7g the fee is paid, the exposure stays reserved" 200.0 (at 'reserved (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params)))
(env-gasmodel "table")
(env-gaslimit 150000)
(env-gas 0)
(expect "M-7h it settles with the oracle's payout" "paid 15.500000000000" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.claim 4 stest.FRANK))
(print (format "GAS claim (20-spin free-spins board that retriggers): {}" [(env-gas)]))
(expect "G-4 the worst-case settlement found, a 20-spin retriggering free-spins board, stays under 15,000 gas" true (< (env-gas) 15000))
(env-gaslimit 99999999)
(expect "M-7i the board row: machines [4], the oracle's stops and payout"
  [[4] [16 5 23 35 6 63 55 46 39 28 13 21 41 21 15 10 42 38 36 43 57 42 6 38 19 34 34 15 21 45 23 54 38 25 58 45 21 59 6 45 7 25 25 60 34 47 50 40 23 6 7 11 50 6 5 5 40 46 55 8] 15.500000000000]
  (let ((b (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-board 4 stest.FRANK))) [(stest.bm b) (at 'stops b) (at 'payout b)]))
(expect "M-7j SPINS-SETTLED carries machines [4]" true
  (contains { "name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.SPINS-SETTLED", "params": [stest.FRANK 4 [4] [16 5 23 35 6 63 55 46 39 28 13 21 41 21 15 10 42 38 36 43 57 42 6 38 19 34 34 15 21 45 23 54 38 25 58 45 21 59 6 45 7 25 25 60 34 47 50 40 23 6 7 11 50 6 5 5 40 46 55 8] 15.500000000000] } (stest.evs)))
(expect "M-7k reserved returns to EXACTLY 0.0" 0.0 (at 'reserved (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-params)))
(expect "M-7l and the round owes nothing" 0.0 (at 'liability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots.get-round 4)))
(rollback-tx)
(env-sigs [])

