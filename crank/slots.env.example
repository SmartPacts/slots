# The slots crank's settings: /etc/slots/crank.env on each host that runs one.
#
# provision-game-crank.sh creates /etc/slots/crank.env from this file when it is missing, and never
# overwrites it afterwards. A host whose file was created from the generic crank.env.example has no
# claim sizing and the crank refuses to start there: copy the CLAIM SIZING lines below into it, or
# put this file in place by hand and set the heartbeat again:
#
#     install -m 0600 -o root -g root /opt/slots-crank/slots.env.example /etc/slots/crank.env
#     # then edit /etc/slots/crank.env: HEARTBEAT_URL (and CRANK_HOST / CRANK_FOLLOWER_MS on a second host)
#
# Everything the generic example documents (HEARTBEAT_URL, CRANK_HOST, LIVENESS_MS,
# CRANK_FOLLOWER_MS) applies here unchanged; read it there. game-crank.mjs reads CRANK_* and the
# names below only: the provisioner refuses a SLOTS_* line in this file.

# THE GAME ---------------------------------------------------------------------
# The rendered unit already sets both; they are repeated here so this file alone says which table
# the process works.
GAME=slots
CRANK_MOD=n_48867b242317a0216a67f8c7ca26696b5878e0e3.slots

# CLAIM SIZING — REQUIRED FOR SLOTS ---------------------------------------------
# A slots claim plays every spin of the board, and a board plays one machine of up to 77 spins,
# so its gas depends on the machine and the spins. Measured on a devnet node on 2026-10-11 UTC,
# against this module: a 77-spin claim mined 4,484-5,027 gas on the line and wild machines,
# 7,253-7,710 on free-spins and 7,965-8,475 on tumble (14 boards); the WORST claim, bounded on the
# node (free-spins, every spin playing all 24 free spins, real-length keys), 108,425. The crank
# budgets a batch at CLAIM_GAS x members + 2,000, and a failed batch is retried forever, so
# CLAIM_GAS must cover the bound: 125,000 is 1.15 x the bound rounded up to a thousand, and
# 125,000 x 1 + 2,000 = 127,000 fits the 150,000 ceiling (two would not). The real crank at this
# setting settled a round of eight 77-spin free-spins boards and a leftover round in one pass, no
# batch failed. Only the gas used is billed, so the cost is more transactions per round, not more
# KDA. game-crank.mjs refuses a slots CLAIM_GAS below 125,000.
CLAIM_GAS=125000
CLAIMS_PER_TX=1

# THE HEARTBEAT ----------------------------------------------------------------
# One check per host, from any uptime monitor that alerts when pings stop; the URL is a
# capability, keep this file 0600.
#HEARTBEAT_URL=https://<your monitoring service>/<your check's ping id>

# THE SECOND HOST --------------------------------------------------------------
# On a second host only: its own node, and the follower delay so it never races the first.
#CRANK_HOST=https://api.chainweb-community.org
#CRANK_FOLLOWER_MS=90000
